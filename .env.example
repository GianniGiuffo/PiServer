# Copy to .env on the Debian 13 mini PC. Replace every CHANGE_ME value,
# keep mode 0600 and never commit the resulting file.

TZ=Europe/Rome

# Public services. SITE_2_DOMAIN may remain unused.invalid if there is only one
# website.
SITE_1_DOMAIN=tommasofrancescon.it
SITE_2_DOMAIN=unused.invalid
VAULTWARDEN_DOMAIN=vault.tommasofrancescon.it
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Public HTTPS hostnames carried by the existing outbound-only Cloudflare
# Tunnel. No Docker or router port is published for these services.
NEXTCLOUD_PUBLIC_DOMAIN=cloud.tommasofrancescon.it
NAVIDROME_PUBLIC_DOMAIN=music.tommasofrancescon.it

# MagicDNS name without the final dot.
TAILSCALE_FQDN=mini-pc.example-tailnet.ts.net

# rack-pi identity used by the mini-PC Uptime Kuma container and Homepage.
# The explicit mapping is required because the mini PC deliberately uses
# accept-dns=false.
RACK_PI_TAILSCALE_FQDN=rack-pi.example-tailnet.ts.net
RACK_PI_TAILSCALE_IP=100.64.0.4

# Tailnet identities allowed to use the Homepage Pi-hole switch. Copy the two
# existing Pi-hole application passwords used by nebula-sync on rack-pi.
PIHOLE_CONTROL_ALLOWED_TAILSCALE_LOGINS=owner@example.com
MINIPC_PIHOLE_CONTROL_PASSWORD=CHANGE_ME
RACK_PI_PIHOLE_CONTROL_PASSWORD=CHANGE_ME

# n8n generates production webhook URLs on its private Tailscale endpoint.
# Keep N8N_WEBHOOK_DOMAIN equal to TAILSCALE_FQDN.
N8N_WEBHOOK_DOMAIN=mini-pc.example-tailnet.ts.net

# Local SSD paths. Keep the historical directory name to make Restic restores
# from the Raspberry Pi straightforward.
STACK_DIR=/opt/raspberry-server
DATA_DIR=/srv/raspberry-server/data
SITES_DIR=/srv/raspberry-server/sites
STAGING_DIR=/srv/raspberry-server/staging

# This must be a real NFS/SMB mount, never a normal directory on the 240 GB SSD.
# start-stack.sh also requires MEDIA_DIR/.piserver-media before media services start.
MEDIA_DIR=/srv/media

# Numeric IDs from:
#   id -u; id -g; getent group render | cut -d: -f3
PUID=1000
PGID=1000
RENDER_GID=render-group-number

# Physical interface used by Homepage for host RX/TX rates. "auto" prefers
# Ethernet/Wi-Fi and ignores Docker, loopback and Tailscale interfaces.
SERVER_NETWORK_INTERFACE=auto

# Generate unique values with openssl. Keep them in a password manager outside
# this server and inside the encrypted Restic snapshots.
PIHOLE_PASSWORD=CHANGE_ME
NEXTCLOUD_DB_PASSWORD=CHANGE_ME
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME
# ONLYOFFICE Docs and the Nextcloud connector must share the same secret.
ONLYOFFICE_JWT_SECRET=CHANGE_ME
STIRLING_PDF_IMAGE=docker.stirlingpdf.com/stirlingtools/stirling-pdf:3.1.0
STIRLING_ADMIN_USERNAME=admin
STIRLING_ADMIN_PASSWORD=CHANGE_ME
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.3.1
IMMICH_DB_PASSWORD=CHANGE_ME_ALPHANUMERIC_ONLY
N8N_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# slskd uses one Soulseek account plus separate local Web/API credentials.
# Generate the last three values with: openssl rand -hex 32
SLSKD_SLSK_USERNAME=CHANGE_ME
SLSKD_SLSK_PASSWORD=CHANGE_ME
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=CHANGE_ME
SLSKD_API_KEY=CHANGE_ME
SLSKD_JWT_KEY=CHANGE_ME

# An Argon2 PHC hash, not a clear-text password. Keep the single quotes because
# the hash contains '$'. See docs/security.md.
VAULTWARDEN_ADMIN_TOKEN='CHANGE_ME'
CLOUDFLARE_TUNNEL_TOKEN='CHANGE_ME'

# Selected service updates reviewed on 13 October 2026. Before updating a stateful service,
# read its release notes, run Restic, pull, recreate and test. Pinning a digest
# after the first successful deployment gives fully immutable images.
CADDY_IMAGE=caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
PIHOLE_IMAGE=pihole/pihole:2026.09.0@sha256:5b9c8cf51de7d6d3f2240dbe72baf5f06e1fd39cb4d77a99fab4fa13e23bd1be
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.4@sha256:efb3cde962015fcc036b2ea625242248611943b27212ebf4392841fb30fad055
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:v2.5.0@sha256:57c4a0531937889c0b968b120fe9c2560bbe036b5c9e18c49a9e2479de9975d1
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.5.0@sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459
MONITORING_API_IMAGE=python:3.14.5-alpine3.22@sha256:6b91e66ab2a880ce9ca5a1b91c70f45963ff71ff68268df056336e1a657d5efd
# Keep the full deployed version so Renovate can propose minor/patch releases.
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2.5.6@sha256:9912da7d7d9b6ddc0c2d904beb84d24689c1ed9c33b81419eb9008663a92a329

# Verified PHP 8.4.27: CVE-2026-109618 / CVE-2026-109619 (2026-10-22).
# Recheck PHP inside candidate images when updating this digest.
NEXTCLOUD_IMAGE=nextcloud:33.0-apache@sha256:a4f8627d317e6de663b700f6a0d022530f038980930a4b81e967e7c19501b839
NGINX_IMAGE=nginx:1.31.3-alpine
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
JELLYFIN_IMAGE=jellyfin/jellyfin:12.2@sha256:357724bf0ae27a672c7cbaa899db2d9abeb13dbd8657ccce750258a4c059d037
# Comics manager: stable release, with SQLite state on the SSD.
KAPOWARR_IMAGE=mrcas/kapowarr:v1.3.2@sha256:cd3f004caff59636dde73b06df5b2f8068b485b47ff5fe82f6129562c0f2ac3b
KOMGA_IMAGE=gotson/komga:1.29.2@sha256:1d89b79f6cee732438c0c51f876373ad1c6a0d6cdae47c008bfa24e1d1bed748
OMNIBUS_IMAGE=ghcr.io/hankscafe/omnibus:v1.4.9@sha256:b887a005f07fbba7c0969bc20250f6bc5541e11efdcf06dff2ab1cd57eb0851a
OMNIBUS_ENGINE_IMAGE=ghcr.io/hankscafe/omnibus-engine:v1.4.9@sha256:6bbaeb0e6ea579243d1797dd102455d529fa5c105bb2cfb5a0166444a52a0f29
# Generate a long random value; the web app and engine share this encryption key.
OMNIBUS_AUTH_SECRET=CHANGE_ME
# Seerr 3.5.0 is validated with the bridge-owned SQLite routing.
# Keep this on an explicit stable tag rather than latest.
SEERR_IMAGE=ghcr.io/seerr-team/seerr:v3.5.0@sha256:27602401178d54f1964442287b9f23f67a3fa2252645ee8065839ea1c3f69e45
# Automated movie/series stack. These are stable upstream application builds
# published by LinuxServer.io; avoid develop/nightly tags for stateful SQLite
# services unless a release-specific migration has been reviewed first.
RADARR_IMAGE=lscr.io/linuxserver/radarr:version-6.4.4.10685
SONARR_IMAGE=lscr.io/linuxserver/sonarr:version-4.0.20.3014
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:version-2.6.5.5623@sha256:f9151e5bc1025c6d0a630d503210cdcb6bb55a7cc098562609d96a408d838902
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.4_v2.0.15-ls480@sha256:97333cc1ccf903e0bbcd8eb67e3332e4970e9c1ecabe145e499e9c0847ebcaed
# Stable release validated with the Seerr bridge; both services use this image.
# Keep the version and digest together for reproducible manual updates.
STREAMINGCOMMUNITY_IMAGE=ghcr.io/edoardofiore/streamingcommunity-downloader:2.6.0@sha256:196ad5c6915cae31d0f2e72ca9c4756e5744dd90cb64700e81e0832d83324eae
IMMICH_SERVER_IMAGE=ghcr.io/immich-app/immich-server:v3.3.1@sha256:db996e352359771c6a3db121a0ed8761516b22f727fc092a0f46dcfef82c1bc1
# PostgreSQL 14 / VectorChord 0.4.3 remain the official v3.3.1 baseline.
# Valkey stays on the compatible major 9 with the current immutable digest.
# A PostgreSQL major upgrade requires dump/restore; never reuse PG14 data on PG16.
IMMICH_REDIS_IMAGE=docker.io/valkey/valkey:9@sha256:418652cfb58ef879d4978c33553735d7147016032d5aefaa14c828e611eb9dfd
IMMICH_POSTGRES_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

# Music stack. Aurral is pinned to the latest reviewed v2 release. Its image
# includes yt-dlp and ffmpeg; the separate slskd container is an optional,
# higher-priority Soulseek source configured from the Aurral web UI.
# The slskd plugin requires Lidarr nightly. Back up Lidarr before switching:
# its database cannot be downgraded safely to stable without a restore.
# Pin the Lidarr digest after the first successful pull if reproducibility
# matters more than automatic nightly updates.
AURRAL_IMAGE=ghcr.io/lklynet/aurral:2.10.0
LIDARR_IMAGE=lscr.io/linuxserver/lidarr:nightly
SLSKD_IMAGE=slskd/slskd:0.26.0
NAVIDROME_IMAGE=deluan/navidrome:0.64.2@sha256:38dc2727bfcfd5ede290f8ada114fc90368146f265ae4701ddddbcbe2a44ee52
# Optional: enable Navidrome's per-user Last.fm authorization/scrobbling.
NAVIDROME_LASTFM_API_KEY=CHANGE_ME
NAVIDROME_LASTFM_SECRET=CHANGE_ME

N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.30.5
