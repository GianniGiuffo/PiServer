# Copy to .env on the Debian 13 mini PC. Replace every CHANGE_ME value,
# keep mode 0600 and never commit the resulting file.

TZ=Europe/Rome

# Public services. SITE_2_DOMAIN may remain unused.invalid if there is only one
# website.
SITE_1_DOMAIN=tommasofrancescon.it
SITE_2_DOMAIN=unused.invalid
VAULTWARDEN_DOMAIN=vault.tommasofrancescon.it
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Public HTTPS hostnames carried by the existing outbound-only Cloudflare
# Tunnel. No Docker or router port is published for these services.
NEXTCLOUD_PUBLIC_DOMAIN=cloud.tommasofrancescon.it
NAVIDROME_PUBLIC_DOMAIN=music.tommasofrancescon.it

# MagicDNS name without the final dot.
TAILSCALE_FQDN=mini-pc.example-tailnet.ts.net

# rack-pi identity used by the mini-PC Uptime Kuma container and Homepage.
# The explicit mapping is required because the mini PC deliberately uses
# accept-dns=false.
RACK_PI_TAILSCALE_FQDN=rack-pi.example-tailnet.ts.net
RACK_PI_TAILSCALE_IP=100.64.0.4

# Tailnet identities allowed to use the Homepage Pi-hole switch. Copy the two
# existing Pi-hole application passwords used by nebula-sync on rack-pi.
PIHOLE_CONTROL_ALLOWED_TAILSCALE_LOGINS=owner@example.com
MINIPC_PIHOLE_CONTROL_PASSWORD=CHANGE_ME
RACK_PI_PIHOLE_CONTROL_PASSWORD=CHANGE_ME

# n8n generates production webhook URLs on its private Tailscale endpoint.
# Keep N8N_WEBHOOK_DOMAIN equal to TAILSCALE_FQDN.
N8N_WEBHOOK_DOMAIN=mini-pc.example-tailnet.ts.net

# Local SSD paths. Keep the historical directory name to make Restic restores
# from the Raspberry Pi straightforward.
STACK_DIR=/opt/raspberry-server
DATA_DIR=/srv/raspberry-server/data
SITES_DIR=/srv/raspberry-server/sites
STAGING_DIR=/srv/raspberry-server/staging

# This must be a real NFS/SMB mount, never a normal directory on the 240 GB SSD.
# start-stack.sh also requires MEDIA_DIR/.piserver-media before media services start.
MEDIA_DIR=/srv/media

# Numeric IDs from:
#   id -u; id -g; getent group render | cut -d: -f3
PUID=1000
PGID=1000
RENDER_GID=render-group-number

# Physical interface used by Homepage for host RX/TX rates. "auto" prefers
# Ethernet/Wi-Fi and ignores Docker, loopback and Tailscale interfaces.
SERVER_NETWORK_INTERFACE=auto

# Generate unique values with openssl. Keep them in a password manager outside
# this server and inside the encrypted Restic snapshots.
PIHOLE_PASSWORD=CHANGE_ME
NEXTCLOUD_DB_PASSWORD=CHANGE_ME
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME
# ONLYOFFICE Docs and the Nextcloud connector must share the same secret.
# Generate with: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=CHANGE_ME
STIRLING_PDF_IMAGE=docker.stirlingpdf.com/stirlingtools/stirling-pdf:3.1.0@sha256:b5b9e400c086e5334a4947a0d7cd589808f743f29267d7f41c18200cf4bc48b4
STIRLING_ADMIN_USERNAME=admin
STIRLING_ADMIN_PASSWORD=CHANGE_ME
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.3.1@sha256:290a0a1406a485acc8a6bc20418ac7158c5eec78b4844c218f8f975a9800ddbc
IMMICH_DB_PASSWORD=CHANGE_ME_ALPHANUMERIC_ONLY
N8N_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# slskd uses one Soulseek account plus separate local Web/API credentials.
# Generate the last three values with: openssl rand -hex 32
SLSKD_SLSK_USERNAME=CHANGE_ME
SLSKD_SLSK_PASSWORD=CHANGE_ME
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=CHANGE_ME
SLSKD_API_KEY=CHANGE_ME
SLSKD_JWT_KEY=CHANGE_ME

# An Argon2 PHC hash, not a clear-text password. Keep the single quotes because
# the hash contains '$'. See docs/security.md.
VAULTWARDEN_ADMIN_TOKEN='CHANGE_ME'
CLOUDFLARE_TUNNEL_TOKEN='CHANGE_ME'

# Reviewed image versions as of July 2026. Before updating a stateful service,
# read its release notes, run Restic, pull, recreate and test. Pinning a digest
# after the first successful deployment gives fully immutable images.
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.5.1@sha256:a5b5e6fd9a372f054b9a843c219bfbcdceb54691605312a8b1ee72978bdf1aa1
PIHOLE_IMAGE=pihole/pihole:2026.07.2@sha256:f7d1be836e3bc608b56d82fc9904f5a831cdfbc0dc9c6d58f94e4c985c70038b
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.1@sha256:ebdfe70701c60ac0c28c697e787cea767d7972940b786037b29fe0d507f821e8
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:v1.13.1@sha256:d8d784e5090111b6e4c56dfd90e272d2953a2094e87349f647165df0fa6c4401
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2@sha256:1f3a6f303320723d199d2316a3e82b2e2685d86c275d5e3deeaf182573b47476
MONITORING_API_IMAGE=python:3.13.13-alpine3.22@sha256:e81548ac35b07a3bd4805f275107592ef458b1e893c0e04d45aedaa19416cca5
# Keep the full deployed version so Renovate can propose minor/patch releases.
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2.4.0@sha256:91e963bfda569ba115206e843febb446f473ab525add4e08b2b9e3beffa16985

NEXTCLOUD_IMAGE=nextcloud:33.0-apache@sha256:8f46dc79e9abf4f1e330ca9a7d9d9b8a8811ecc28f18018c1951281e522499e8
NGINX_IMAGE=nginx:1.31.3-alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
POSTGRES_IMAGE=postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
REDIS_IMAGE=redis:7-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
JELLYFIN_IMAGE=jellyfin/jellyfin:12.1@sha256:78d3ea1207d1322471fcac39a614f004f2ccf7e878f95ab2977d752f07e4dd7e
# Seerr 3.4.1 includes the avatar proxy path-traversal security fix introduced
# in 3.4.0. Keep this on an explicit stable tag rather than latest.
SEERR_IMAGE=ghcr.io/seerr-team/seerr:v3.4.1@sha256:f4768de5f616248d723e05891f3345a1402123775d03bf0890dbfedc0831bda1
# Automated movie/series stack. These are stable upstream application builds
# published by LinuxServer.io; avoid develop/nightly tags for stateful SQLite
# services unless a release-specific migration has been reviewed first.
RADARR_IMAGE=lscr.io/linuxserver/radarr:version-6.4.4.10685@sha256:7dfd049e79c00b16fbc29c3f5d96a9e7b9e73a23930b4c5b3c4541d60b366814
SONARR_IMAGE=lscr.io/linuxserver/sonarr:version-4.0.20.3014@sha256:dffc730adcb8b4f4342792fbb27fcad9c62fb8660523f2aeb082416980d7fe0c
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:version-2.5.2.5491@sha256:aaa16ba7d66e413db6d0358d3b6c68d833578ba7f176f24a51807181e7637fce
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.3_v2.0.14-ls476@sha256:2be038f3421f60f62e8e4bf201f66f385b68e4fbc9ed3ab79051069ea22e2650
BAZARR_IMAGE=lscr.io/linuxserver/bazarr:version-v1.6.0@sha256:84b6f05a7a4194fafe5a0bec062d32f6ae9ea74db33d43d678cb9a3191f31c24
# Upstream currently publishes the authenticated Jellyfin-integrated panel only
# through the rolling latest image. update-images.sh pulls it only on request.
STREAMINGCOMMUNITY_IMAGE=ghcr.io/edoardofiore/streamingcommunity-downloader:latest@sha256:2daa82e2484b0f8a878fad607ec6629d8010eb54dc77ebcfb8d7fb2cfe6db5cd
IMMICH_SERVER_IMAGE=ghcr.io/immich-app/immich-server:v3@sha256:db996e352359771c6a3db121a0ed8761516b22f727fc092a0f46dcfef82c1bc1
# These two pins follow Immich's official v3 Compose baseline.
IMMICH_REDIS_IMAGE=docker.io/valkey/valkey:9@sha256:8e8d64b405ce18f41b8e5ee20aa4687a8ed0022d1298f2ce31cdcf3a76e09411
IMMICH_POSTGRES_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

# Music stack. Aurral is pinned to the latest reviewed v2 release. Its image
# includes yt-dlp and ffmpeg; the separate slskd container is an optional,
# higher-priority Soulseek source configured from the Aurral web UI.
# The slskd plugin requires Lidarr nightly. Back up Lidarr before switching:
# its database cannot be downgraded safely to stable without a restore.
# Pin the Lidarr digest after the first successful pull if reproducibility
# matters more than automatic nightly updates.
AURRAL_IMAGE=ghcr.io/lklynet/aurral:2.10.0@sha256:e15f05e525a7c9d4a97e36ff18b6a37904dda6c803e46f0fd87900a7021febae
LIDARR_IMAGE=lscr.io/linuxserver/lidarr:nightly@sha256:fe4a744c0ac255e73a9a801a7f021ca1b1613963911170c61374e8fdec03b1cb
SLSKD_IMAGE=slskd/slskd:0.26.0@sha256:ecd4026d4f8fb504e2cc55323efa2c1f5b56d20d3686b018249cc36b48ea17a6
NAVIDROME_IMAGE=deluan/navidrome:0.63.2@sha256:9012939114fbb1bb641b81cf96dec5ded15f0aafefe8d47a511d7cb919658e40
# Optional: enable Navidrome's per-user Last.fm authorization/scrobbling.
NAVIDROME_LASTFM_API_KEY=CHANGE_ME
NAVIDROME_LASTFM_SECRET=CHANGE_ME

N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.30.5@sha256:450853cd21a2ce36587c4c860eb26927c1ceba9496bf55f4c213b5d3a6dc8c6f
SEARXNG_IMAGE=searxng/searxng:2026.7.26-b060c780d@sha256:d0aaeb14880e6e92bde1518fcc7261e995783367d63d95203383607bef9c6516
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME
