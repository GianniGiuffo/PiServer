# Copy to .env on the Debian 13 mini PC. Replace every CHANGE_ME value,
# keep mode 0600 and never commit the resulting file.

TZ=Europe/Rome

# Public services. SITE_2_DOMAIN may remain unused.invalid if there is only one
# website.
SITE_1_DOMAIN=tommasofrancescon.it
SITE_2_DOMAIN=unused.invalid
VAULTWARDEN_DOMAIN=vault.tommasofrancescon.it
VAULTWARDEN_SIGNUPS_ALLOWED=false

# MagicDNS name without the final dot.
TAILSCALE_FQDN=mini-pc.example-tailnet.ts.net

# n8n generates production webhook and Hosted Chat URLs on its private
# Tailscale endpoint. Keep N8N_WEBHOOK_DOMAIN equal to TAILSCALE_FQDN. After
# activating the Chat Trigger, copy the part of its production Chat URL that
# starts with "/" into N8N_CHAT_PATH.
N8N_WEBHOOK_DOMAIN=mini-pc.example-tailnet.ts.net
N8N_CHAT_PATH=/webhook/replace-with-the-production-chat-path
OLLAMA_MODEL=qwen2.5:3b

# Local SSD paths. Keep the historical directory name to make Restic restores
# from the Raspberry Pi straightforward.
STACK_DIR=/opt/raspberry-server
DATA_DIR=/srv/raspberry-server/data
SITES_DIR=/srv/raspberry-server/sites
STAGING_DIR=/srv/raspberry-server/staging

# This must be a real NFS/SMB mount, never a normal directory on the 240 GB SSD.
# start-stack.sh also requires MEDIA_DIR/.piserver-media before media services start.
MEDIA_DIR=/srv/media

# Numeric IDs from:
#   id -u; id -g; getent group render | cut -d: -f3
PUID=1000
PGID=1000
RENDER_GID=render-group-number

# Physical interface used by Homepage for host RX/TX rates. "auto" prefers
# Ethernet/Wi-Fi and ignores Docker, loopback and Tailscale interfaces.
SERVER_NETWORK_INTERFACE=auto

# Generate unique values with openssl. Keep them in a password manager outside
# this server and inside the encrypted Restic snapshots.
PIHOLE_PASSWORD=CHANGE_ME
NEXTCLOUD_DB_PASSWORD=CHANGE_ME
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME
IMMICH_DB_PASSWORD=CHANGE_ME_ALPHANUMERIC_ONLY
N8N_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# slskd uses one Soulseek account plus separate local Web/API credentials.
# Generate the last three values with: openssl rand -hex 32
SLSKD_SLSK_USERNAME=CHANGE_ME
SLSKD_SLSK_PASSWORD=CHANGE_ME
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=CHANGE_ME
SLSKD_API_KEY=CHANGE_ME
SLSKD_JWT_KEY=CHANGE_ME

# An Argon2 PHC hash, not a clear-text password. Keep the single quotes because
# the hash contains '$'. See docs/security.md.
VAULTWARDEN_ADMIN_TOKEN='CHANGE_ME'
CLOUDFLARE_TUNNEL_TOKEN='CHANGE_ME'

# Reviewed image versions as of July 2026. Before updating a stateful service,
# read its release notes, run Restic, pull, recreate and test. Pinning a digest
# after the first successful deployment gives fully immutable images.
CADDY_IMAGE=caddy:2.11.4-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.5.1
PIHOLE_IMAGE=pihole/pihole:2026.05.0
VAULTWARDEN_IMAGE=vaultwarden/server:1.36.0
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:v1.13.1
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2
MONITORING_API_IMAGE=python:3.13.13-alpine3.22
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2

NEXTCLOUD_IMAGE=nextcloud:33.0-apache
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.11
# Upstream currently publishes the authenticated Jellyfin-integrated panel only
# through the rolling latest image. update-images.sh pulls it only on request.
STREAMINGCOMMUNITY_IMAGE=ghcr.io/edoardofiore/streamingcommunity-downloader:latest
IMMICH_SERVER_IMAGE=ghcr.io/immich-app/immich-server:v3
# These two pins follow Immich's official v3 Compose baseline.
IMMICH_REDIS_IMAGE=docker.io/valkey/valkey:9@sha256:8e8d64b405ce18f41b8e5ee20aa4687a8ed0022d1298f2ce31cdcf3a76e09411
IMMICH_POSTGRES_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

# Music stack. Aurral is pinned to the last v1 release reviewed before its
# announced v2 migration. LinuxServer publishes Lidarr stable through a rolling
# tag; pin its digest after the first successful pull.
AURRAL_IMAGE=ghcr.io/lklynet/aurral:1.76.51
LIDARR_IMAGE=lscr.io/linuxserver/lidarr:latest
SLSKD_IMAGE=slskd/slskd:0.26.0
NAVIDROME_IMAGE=deluan/navidrome:0.63.2
# Optional: enable Navidrome's per-user Last.fm authorization/scrobbling.
NAVIDROME_LASTFM_API_KEY=CHANGE_ME
NAVIDROME_LASTFM_SECRET=CHANGE_ME

N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.30.5
OLLAMA_IMAGE=ollama/ollama:0.32.0
