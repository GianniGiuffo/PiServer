[Unit]
Description=Create an encrypted off-device PiServer backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
ExecStart=/usr/bin/bash __REPO_DIR__/scripts/backup.sh
TimeoutStartSec=5h
TimeoutStopSec=10min
Nice=19
IOSchedulingClass=idle
