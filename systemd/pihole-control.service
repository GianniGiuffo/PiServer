[Unit]
Description=Control both Pi-hole blockers from Homepage
Wants=network-online.target
After=network-online.target core-stack.service
Requires=core-stack.service
ConditionPathExists=__REPO_DIR__/.env

[Service]
Type=simple
User=__RPI_USER__
Group=__RPI_GROUP__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
ExecStart=/usr/bin/python3 __REPO_DIR__/scripts/pihole-control.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
