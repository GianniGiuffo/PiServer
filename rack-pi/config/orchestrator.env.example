# Install as /etc/rack-pi/orchestrator.env with mode 0600.
MINIPC_SSH_HOST=100.64.0.3
MINIPC_SSH_PORT=2222
MINIPC_SSH_USER=pibackup
MINIPC_SSH_KEY=/etc/rack-pi/ssh/minipc-backup
MINIPC_KNOWN_HOSTS=/etc/rack-pi/ssh/known_hosts
REMOTE_BACKUP_TIMEOUT=7h

# Create Push monitors in rack-pi's Uptime Kuma and paste their complete local
# URLs here. notificationBot remains configured only inside Uptime Kuma.
UPTIME_KUMA_BACKUP_PUSH_URL=
UPTIME_KUMA_MAINTENANCE_PUSH_URL=
