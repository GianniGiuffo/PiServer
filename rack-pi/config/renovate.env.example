# Install as /etc/rack-pi/renovate.env (root:root, mode 0600).
# Reuse StatusBot's token/chat ID from Uptime Kuma's notification settings.
# Never copy its database or add real credentials to Git.
RENOVATE_TOKEN=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
# Optional Telegram topic/thread ID; empty for a normal conversation.
TELEGRAM_MESSAGE_THREAD_ID=
# Explicit arm64-compatible release; bot updates are manual.
RENOVATE_IMAGE=ghcr.io/renovatebot/renovate:44.143.0
