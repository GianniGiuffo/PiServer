# Install as /etc/rack-pi/ups.env with mode 0600.
UPS_NAME=eaton
UPS_MINIPC_SHUTDOWN_PERCENT=40
UPS_RACK_SHUTDOWN_PERCENT=15
UPS_POLL_SECONDS=10
UPS_CRITICAL_CONFIRM_SECONDS=30
UPS_MINIPC_GRACE_SECONDS=90

# Dedicated, forced-command SSH account installed on the mini PC by
# scripts/install-ups-power-client.sh. Do not reuse the backup key.
MINIPC_POWER_SSH_HOST=100.64.0.3
MINIPC_POWER_SSH_PORT=2223
MINIPC_POWER_SSH_USER=pipower
MINIPC_POWER_SSH_KEY=/etc/rack-pi/ssh/minipc-power
MINIPC_POWER_KNOWN_HOSTS=/etc/rack-pi/ssh/known_hosts-power

# Needed when mains returns before the UPS reaches 15% and therefore never
# cycles its outlets. Use the mini PC Ethernet MAC and LAN broadcast address.
MINIPC_LAN_MAC=00:11:22:33:44:55
MINIPC_LAN_BROADCAST=192.168.1.255
