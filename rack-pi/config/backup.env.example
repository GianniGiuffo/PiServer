# Install as /etc/rack-pi/backup.env with owner root:root and mode 0600.
BACKUP_MOUNTPOINT=/mnt/rack-backup

MINIPC_STATE_REPOSITORY=/mnt/rack-backup/repositories/minipc/state
MINIPC_STATE_PASSWORD_FILE=/etc/rack-pi/restic-minipc-password
MINIPC_STATE_TAG=minipc-state

PHOTOS_ENABLED=false
PHOTOS_REPOSITORY=/mnt/rack-backup/repositories/minipc/photos
PHOTOS_PASSWORD_FILE=/etc/rack-pi/restic-photos-password
PHOTOS_TAG=photos

RACK_PI_REPOSITORY=/mnt/rack-backup/repositories/rack-pi/state
RACK_PI_PASSWORD_FILE=/etc/rack-pi/restic-rack-pi-password
RACK_PI_TAG=rack-pi-state

RESTIC_OPERATION_TIMEOUT=5h
