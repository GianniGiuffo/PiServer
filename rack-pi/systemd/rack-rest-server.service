[Unit]
Description=Serve append-only Restic repositories on rack-pi
Wants=network-online.target
After=network-online.target docker.service tailscaled.service
Requires=docker.service
StartLimitIntervalSec=10min
StartLimitBurst=3
ConditionPathExists=__RACK_DIR__/.env
ConditionPathExists=/etc/rack-pi/rest-server.htpasswd

[Service]
Type=simple
WorkingDirectory=__RACK_DIR__
ExecStartPre=/usr/bin/bash __RACK_DIR__/scripts/check-backup-disk.sh
ExecStart=/usr/bin/docker compose --profile backup up rest-server
ExecStop=/usr/bin/docker compose --profile backup stop rest-server
Restart=on-failure
RestartSec=2min
TimeoutStartSec=10min
TimeoutStopSec=3min

[Install]
WantedBy=multi-user.target
