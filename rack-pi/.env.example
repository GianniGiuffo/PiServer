# Copy to rack-pi/.env on rack-pi, replace every CHANGE_ME value and chmod 0600.
TZ=Europe/Rome

# MagicDNS names without the trailing dot and stable Tailscale IPv4 addresses.
RACK_PI_TAILSCALE_FQDN=rack-pi.example-tailnet.ts.net
RACK_PI_TAILSCALE_IP=100.64.0.2
MINIPC_TAILSCALE_FQDN=mini-pc.example-tailnet.ts.net
MINIPC_TAILSCALE_IP=100.64.0.3

DATA_DIR=/srv/rack-pi/data
BACKUP_MOUNTPOINT=/mnt/rack-backup
SERVER_NETWORK_INTERFACE=auto

# Use long alphanumeric values for the two Pi-hole API credentials used by
# nebula-sync. Reserved URL characters make its URL|password format ambiguous.
PIHOLE_PASSWORD=CHANGE_ME_ALPHANUMERIC
PIHOLE_MAX_DB_DAYS=30
MINIPC_PIHOLE_SYNC_PASSWORD=CHANGE_ME_ALPHANUMERIC
RACK_PI_PIHOLE_SYNC_PASSWORD=CHANGE_ME_ALPHANUMERIC

# Reviewed arm64-compatible images. Update only after a working backup.
PIHOLE_IMAGE=pihole/pihole:2026.05.0
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:v1.13.1
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2
MONITORING_API_IMAGE=python:3.13.13-alpine3.22
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2.3.2
NEBULA_SYNC_IMAGE=ghcr.io/lovelaze/nebula-sync:v0.11.2
REST_SERVER_IMAGE=restic/rest-server:0.14.0
