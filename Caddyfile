{
	# Cloudflare provides public HTTPS. Caddy receives private HTTP only from the
	# cloudflared container, so it must not attempt ACME certificates or redirects.
	auto_https off
}

# Keep access metadata across container replacements, without storing share
# tokens, document URLs, query strings, cookies or authorization headers.
(security_access_log) {
	log {
		output file /data/security-access.jsonl {
			mode 0600
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
	# Public listeners are reached through the Cloudflare Tunnel. This field is
	# edge-reported metadata, not an authorization decision.
	log_append edge_client_ip {http.request.header.CF-Connecting-IP}
}

# ONLYOFFICE virtual path. Only the browser routes below reach the document
# server; Nextcloud and ONLYOFFICE still communicate on the Docker frontend.
(onlyoffice_public_proxy) {
	uri strip_prefix /office
	reverse_proxy onlyoffice:80 {
		header_up X-Forwarded-Host {$NEXTCLOUD_PUBLIC_DOMAIN}/office
		header_up X-Forwarded-Proto https
		header_up -X-Forwarded-Prefix
		header_up -CloudFront-Forwarded-Proto
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}

http://{$SITE_1_DOMAIN} {
	import security_access_log
	encode zstd gzip
	root * /srv/sites/site-1/current

	# The public section entry explains how to connect through Tailscale. Actual
	# private documents remain unavailable through the public domain.
	@private_entry path /private /private/ /en/private /en/private/
	handle @private_entry {
		redir /accesso-privato/ 302
	}
	@private_site path /private/* /en/private/*
	handle @private_site {
		respond 404
	}
	handle {
		file_server
	}
	header -Server
}

# This listener is mapped only to the host loopback address. Tailscale Serve
# exposes it on a dedicated tailnet-only HTTPS port; Cloudflare never reaches it.
http://:8083 {
	encode zstd gzip
	root * /srv/sites/site-1/current
	file_server
	header -Server
}

http://{$SITE_2_DOMAIN} {
	import security_access_log
	encode zstd gzip
	root * /srv/sites/site-2/current
	file_server
	header -Server
}

http://:80 {
	respond 404
}

# Dedicated Docker-only origin for the Cloudflare Tunnel route.
# The private Tailscale route reaches the frontend independently of this vhost.
http://{$PENPOT_PUBLIC_DOMAIN}:8089 {
	import security_access_log
	reverse_proxy penpot-frontend:8080 {
		header_up X-Forwarded-Proto https
		header_up -Cf-Access-Jwt-Assertion
		header_down Cache-Control "private, no-store"
	}
	header -Server
}

# Keep the existing Tailnet hostname and sessions as a recovery path.
http://:8084 {
	reverse_proxy nextcloud-origin:80 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 8445
	}
	header -Server
}

http://{$NEXTCLOUD_PUBLIC_DOMAIN} {
	import security_access_log
	header {
		>Cache-Control "private, no-store"
		>Cloudflare-CDN-Cache-Control "no-store"
		>Strict-Transport-Security "max-age=15552000"
		-Server
	}

	# Trust the edge header only from the single cloudflared peer. The
	# listener is otherwise reachable from other Docker networks.
	@tunnel {
		remote_ip 10.203.253.2
		header_regexp CF-Connecting-IP ^[0-9A-Fa-f:.]+$
	}
	@office path /office /office/*
	@unencrypted not header X-Forwarded-Proto https
	@public_enabled expression `"{$NEXTCLOUD_PUBLIC_ENABLED:false}" == "true"`
	@dav_discovery path /.well-known/caldav /.well-known/carddav
	@office_callbacks path_regexp officeCallbacks ^/(?:index\.php/)?apps/onlyoffice/(?:download|empty|track)/?$
	@office_assets {
		method GET HEAD
		path_regexp officeAssets ^/office/(?:[0-9]+\.[0-9]+\.[0-9]+[.-][A-Za-z0-9_]+/)?(?:(?:web-apps|sdkjs|sdkjs-plugins|fonts|dictionaries)/.+|document_editor_service_worker\.js|plugins\.json|themes\.json|meta/formats)$
	}
	@office_sessions {
		method GET POST OPTIONS
		path_regexp officeSessions ^/office/(?:[0-9]+\.[0-9]+\.[0-9]+[.-][A-Za-z0-9_]+/)?(?:doc/[A-Za-z0-9_.=-]+/c(?:/.*)?|downloadas/[A-Za-z0-9_.=-]+)$
	}
	@office_signed_files {
		method GET HEAD
		path /office/cache/files/*
	}

	handle @tunnel {
		redir @unencrypted https://{$NEXTCLOUD_PUBLIC_DOMAIN}{uri} 308
		handle @office {
			handle @office_assets {
				import onlyoffice_public_proxy
			}
			handle @office_sessions {
				import onlyoffice_public_proxy
			}
			handle @office_signed_files {
				import onlyoffice_public_proxy
			}
			handle {
				respond 404
			}
		}
		handle @public_enabled {
			respond @office_callbacks 404
			redir @dav_discovery /remote.php/dav/ 301
			reverse_proxy nextcloud-origin:80 {
				header_up Host {$NEXTCLOUD_PUBLIC_DOMAIN}
				header_up X-Forwarded-Host {$NEXTCLOUD_PUBLIC_DOMAIN}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
				header_up -Forwarded
				header_up -X-Real-IP
				header_up -Cf-Access-Jwt-Assertion
			}
		}
		handle {
			respond 404
		}
	}
	handle {
		respond 404
	}
}

# Navidrome has anonymous tokenized shares but no per-share password. Expose
# only its public share handler; login, API and the normal UI stay Tailnet-only.
http://{$NAVIDROME_PUBLIC_DOMAIN} {
	import security_access_log
	@public_share {
		method GET HEAD OPTIONS
		path /share /share/*
	}
	handle @public_share {
		encode zstd gzip
		reverse_proxy navidrome:4533 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}
	handle {
		respond 404
	}
	header -Server
}
