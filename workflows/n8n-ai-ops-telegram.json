      "id": "3a69dcab-acde-4d45-bf30-cf2921528ae0",
      "name": "OpenAI Responses API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        -160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_OPENAI_CREDENTIAL",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $json;\nconst request = $('Route Telegram Update').first().json;\nconst texts = [];\nfor (const item of source.output ?? []) {\n  for (const content of item.content ?? []) {\n    if (content.type === 'output_text' && typeof content.text === 'string') texts.push(content.text);\n    if (content.type === 'refusal') throw new Error('OpenAI ha rifiutato la diagnosi: ' + (content.refusal ?? 'motivo non disponibile'));\n  }\n}\nif (!texts.length) throw new Error('La risposta OpenAI non contiene output_text');\nconst plan = JSON.parse(texts.join(''));\nconst lines = [\n  'DIAGNOSI AI - nessuna modifica ancora eseguita',\n  '',\n  'Sintesi: ' + plan.summary,\n  '',\n  'Problema individuato:',\n  plan.problem,\n  '',\n  'Evidenze:',\n  ...(plan.evidence.length ? plan.evidence.map((v, i) => (i + 1) + '. ' + v) : ['Nessuna evidenza conclusiva.']),\n  '',\n  'Modifiche proposte:'\n];\nif (!plan.actions.length) {\n  lines.push('Nessuna azione eseguibile proposta.');\n} else {\n  plan.actions.forEach((action, i) => {\n    lines.push((i + 1) + '. ' + action.type + (action.target ? ' -> ' + action.target : ''));\n    lines.push('   Motivo: ' + action.rationale);\n    if (action.patch) {\n      lines.push('   Patch esatta:');\n      lines.push(action.patch);\n    }\n  });\n}\nlines.push('', 'Rischi:');\nlines.push(...(plan.risks.length ? plan.risks.map((v, i) => (i + 1) + '. ' + v) : ['Nessun rischio aggiuntivo dichiarato.']));\nlines.push('', 'Verifica prevista:');\nlines.push(...(plan.verification.length ? plan.verification.map((v, i) => (i + 1) + '. ' + v) : ['Nuova diagnostica di base dopo l’esecuzione.']));\nreturn [{ json: {\n  ...request,\n  plan,\n  has_actions: plan.actions.length > 0 ? 'yes' : 'no',\n  report: lines.join('\\n')\n}}];"
      },
