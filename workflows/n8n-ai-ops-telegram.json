    {
      "parameters": {
        "jsCode": "const update = $json.body ?? $json;\nconst callback = update.callback_query;\nconst message = update.message;\nconst user = callback?.from ?? message?.from;\nconst chat = callback?.message?.chat ?? message?.chat;\n\nif (!user || !chat) return [];\nif (callback) {\n  const match = /^(aiok|aino):([a-f0-9]{12}):([A-Za-z0-9_-]{10,})$/.exec(callback.data ?? '');\n  if (!match) return [];\n  return [{ json: {\n    route: match[1] === 'aiok' ? 'approve' : 'deny',\n    plan_id: match[2],\n    approval_token: match[3],\n    chat_id: chat.id,\n    user_id: user.id,\n    callback_query_id: callback.id\n  }}];\n}\n\nconst text = String(message?.text ?? '').trim();\nconst command = /^\\/fix(?:@\\w+)?(?:\\s+([\\s\\S]+))?$/i.exec(text);\nif (!command || !command[1]?.trim()) {\n  return [{ json: {\n    route: 'help',\n    chat_id: chat.id,\n    user_id: user.id,\n    text: 'Usa /fix seguito dalla descrizione del problema. Non inserire password, token o dati privati.'\n  }}];\n}\nreturn [{ json: {\n  route: 'diagnose',\n  chat_id: chat.id,\n  user_id: user.id,\n  prompt: command[1].trim().slice(0, 8000)\n}}];"
      },
