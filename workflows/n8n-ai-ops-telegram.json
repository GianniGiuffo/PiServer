    {
      "parameters": {
        "jsCode": "const route = $('Route Telegram Update').first().json;\nconst execution = $('Esegui piano').first().json;\nconst diagnostics = $json;\nconst lines = [\n  execution.status === 'completed' ? 'ESECUZIONE COMPLETATA' : 'ESECUZIONE NON COMPLETATA',\n  'Piano: ' + execution.id,\n  'Stato: ' + execution.status,\n  ''\n];\nfor (const [index, result] of (execution.results ?? []).entries()) {\n  lines.push((index + 1) + '. ' + result.type + (result.target ? ' -> ' + result.target : ''));\n  lines.push('   Esito: ' + (result.ok ? 'OK' : 'ERRORE'));\n  if (result.paths?.length) lines.push('   File: ' + result.paths.join(', '));\n  if (result.output) lines.push('   Output: ' + String(result.output).slice(0, 6000));\n}\nlines.push('', 'Controllo successivo: nuova diagnostica acquisita.');\nconst unhealthy = [];\nfor (const [stack, value] of Object.entries(diagnostics.compose ?? {})) {\n  if (!value.ok) unhealthy.push(stack + ': diagnostica Compose non riuscita');\n}\nif (unhealthy.length) lines.push(...unhealthy);\nreturn [{ json: { chat_id: route.chat_id, text: lines.join('\\n') } }];"
