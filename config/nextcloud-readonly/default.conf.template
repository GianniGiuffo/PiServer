server {
  listen 8080;
  server_name _;

  proxy_http_version 1.1;
  proxy_set_header Host ${NEXTCLOUD_INTERNAL_HOST}:8445;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Host ${NEXTCLOUD_INTERNAL_HOST}:8445;
  proxy_set_header X-Forwarded-Proto https;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "OK\n";
  }

  # n8n uses this read-only endpoint to test the Nextcloud credential.
  location = /ocs/v1.php/cloud/capabilities {
    limit_except GET {
      deny all;
    }
    proxy_pass http://nextcloud:80;
  }

  # Allow only file download and directory/property inspection. NGINX grants
  # HEAD whenever GET is allowed. Every WebDAV write method returns 403.
  location ^~ /remote.php/webdav {
    limit_except GET PROPFIND OPTIONS {
      deny all;
    }
    proxy_pass http://nextcloud:80;
    proxy_buffering off;
  }

  # Do not expose any other Nextcloud API through the connector network.
  location / {
    return 404;
  }
}
