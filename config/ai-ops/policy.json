{
  "plan_ttl_seconds": 900,
  "max_actions_per_plan": 5,
  "max_patch_bytes": 32768,
  "diagnostic_units": [
    "core-stack.service",
    "media-stack.service",
    "automation-stack.service",
    "backup.service",
    "backup.timer",
    "media-recovery.service",
    "media-recovery.timer"
  ],
  "diagnostic_files": [
    "Caddyfile",
    "compose.yaml",
    "compose.media.yaml",
    "compose.automation.yaml"
  ],
  "restartable_systemd_units": [
    "core-stack.service",
    "media-stack.service",
    "backup.timer",
    "media-recovery.timer"
  ],
  "restartable_compose_services": {
    "caddy": "core",
    "pihole": "core",
    "vaultwarden": "core",
    "homepage": "core",
    "uptime-kuma": "core",
    "nextcloud": "media",
    "nextcloud-cron": "media",
    "jellyfin": "media",
    "immich-server": "media",
    "lidarr": "media",
    "slskd": "media",
    "navidrome": "media",
    "aurral": "media",
    "ollama": "automation",
    "searxng": "automation"
  },
  "maintenance_tasks": [
    "preflight",
    "refresh-backup-status",
    "refresh-media-status",
    "recover-media-stack"
  ],
  "patch_allowed_roots": [
    "config",
    "docs",
    "scripts",
    "systemd"
  ],
  "patch_allowed_files": [
    ".env.example",
    "Caddyfile",
    "README.md",
    "compose.yaml",
    "compose.media.yaml",
    "compose.automation.yaml"
  ],
  "patch_denied_files": [
    "config/ai-ops/policy.json",
    "scripts/ai-ops-bridge.py",
    "scripts/ai-ops-gateway.py",
    "scripts/ai-ops-telegram.py",
    "scripts/install-systemd.sh",
    "systemd/ai-ops-gateway.service"
  ]
}
