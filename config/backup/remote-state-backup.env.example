# Replace /etc/raspberry-server/backup.env on the mini-PC only after the old
# repository has been copied and verified on rack-pi. Keep mode 0600.

# Percent-encode reserved characters in REST_SERVER_PASSWORD. The transport is
# confined to Tailscale; Restic also encrypts all repository content itself.
RESTIC_REPOSITORY=rest:http://minipc:REST_SERVER_PASSWORD@100.64.0.2:8000/minipc/state
RESTIC_PASSWORD_FILE=/etc/restic/password
RESTIC_BACKUP_TAG=minipc-state
RESTIC_SKIP_RETENTION=true
RESTIC_OPERATION_TIMEOUT=5h
BACKUP_SCHEDULE_TIME=04:15
# rack-pi invokes this host through its restricted SSH account. The mini-PC's
# legacy backup and recovery timers must remain disabled across reinstalls.
BACKUP_TIMER_MANAGED_EXTERNALLY=true
