# Install as /etc/raspberry-server/photos-backup.env with mode 0600.
# Leave disabled until /srv/media is a verified mount containing the photo tree.

PHOTO_BACKUP_ENABLED=false
PHOTO_SOURCE=/srv/media/immich
PHOTO_MEDIA_MOUNTPOINT=/srv/media
PHOTO_MEDIA_MARKER=.piserver-media

# The URL is served by rack-pi on its Tailscale IPv4 address. Percent-encode
# reserved characters in the HTTP password, or generate an alphanumeric value.
RESTIC_REPOSITORY=rest:http://minipc:REST_SERVER_PASSWORD@100.64.0.2:8000/minipc/photos
RESTIC_PASSWORD_FILE=/etc/restic/photos-password
RESTIC_BACKUP_TAG=photos
RESTIC_OPERATION_TIMEOUT=5h
