# Install as /etc/raspberry-server/gaming/gaming.env with mode 0640.
# Values here are examples only. Never commit the real file.

# Wired NIC hardware address and the directed broadcast of the home LAN.
GAMING_PC_MAC=00:11:22:33:44:55
GAMING_PC_BROADCAST=192.168.1.255
GAMING_PC_WOL_PORT=9

# Stable Tailscale IPv4 shown for the Windows PC in the Machines page.
GAMING_PC_TAILSCALE_IP=100.64.0.10
GAMING_PC_SUNSHINE_PORT=47984
GAMING_PC_SSH_PORT=22
GAMING_PC_SSH_USER=gaming

# Exact Tailscale login allowed to operate the web page. Multiple identities
# may be comma-separated. Use a normal user-authenticated Switch node: tagged
# nodes do not receive Tailscale-User-Login headers from Serve.
GAMING_ALLOWED_TAILSCALE_LOGINS=user@example.com

GAMING_PC_SSH_KEY=/etc/raspberry-server/gaming/id_ed25519
GAMING_PC_KNOWN_HOSTS=/etc/raspberry-server/gaming/known_hosts
GAMING_SESSION_TOKEN_FILE=/etc/raspberry-server/gaming/session-token

# The timer is armed only when this controller woke the PC. Sunshine's global
# prep/undo callbacks pause and restart the countdown around every stream.
GAMING_IDLE_TIMEOUT_SECONDS=1800
GAMING_WAKE_TIMEOUT_SECONDS=180
GAMING_POLL_INTERVAL_SECONDS=5

# Do not change the listener to a non-loopback address. Tailscale Serve is the
# authentication proxy and strips spoofed identity headers.
GAMING_CONTROLLER_BIND=127.0.0.1
GAMING_CONTROLLER_PORT=8084
GAMING_CONTROLLER_STATE_FILE=/var/lib/raspberry-server/gaming-controller/state.json
